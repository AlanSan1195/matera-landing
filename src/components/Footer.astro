---
import SocialLinks from "./SocialLinks.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  lang?: Lang;
}
const { lang = "es" } = Astro.props;
const t = useTranslations(lang);
---

<footer class="relative md:mt-24 lg:mt-32 overflow-hidden">
  <!-- Línea decorativa roja -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-red-900/50 to-transparent"></div>

  <div class="mx-auto w-full px-6 md:px-12 py-10 md:py-14">

    <!-- Fila principal: logo | dirección | horarios | acciones -->
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 md:gap-8">

      <!-- Logo -->
      <div class="flex justify-center md:justify-start">
        <img
          class="h-10 md:h-12 opacity-80"
          src="https://www.lamatera.mx/wp-content/themes/bmx-lamatera/assets/img-logotipo-rojo.svg"
          alt="Logo de La Matera"
          loading="lazy"
          width="120"
          height="48"
        />
      </div>

      <!-- Dirección -->
      <div class="text-center md:text-left">
        <address class="not-italic text-sm text-white/50 leading-relaxed font-light">
          <span class="font-display text-base text-white/70 tracking-wide block mb-1">Av. M&eacute;xico 2895</span>
          Col. Vallarta Norte C.P 44690<br />
          Guadalajara, Jalisco
        </address>
      </div>

      <!-- Horarios -->
      <div class="text-center md:text-left">
        <div class="text-sm text-white/50 leading-relaxed font-light">
          <span class="font-display text-base text-white/70 tracking-wide block mb-1">{t.footer.horarios}</span>
          {t.footer.lunes}<br />
          {t.footer.domingo}
        </div>
      </div>

      <!-- Facturar + Redes -->
      <div class="flex flex-col items-center md:items-end gap-4">
        <a
          class="group inline-flex items-center gap-2.5
                 border border-red-900/40 px-5 py-2.5
                 text-xs font-display text-white/60
                 transition-all duration-300
                 hover:border-red-800 hover:text-white tracking-[0.15em] uppercase"
          href="https://api.whatsapp.com/send/?phone=523318457029&text&type=phone_number&app_absent=0"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            class="h-3.5 w-3.5 opacity-60 transition-opacity duration-300 group-hover:opacity-100"
            src="https://www.lamatera.mx/wp-content/themes/bmx-lamatera/assets/img-whatsapplogo.svg"
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="14"
            height="14"
          />
          {t.footer.facturar}
        </a>
        <SocialLinks />
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 pt-6 border-t border-white/[0.06]">
      <p class="text-center text-[11px] text-white/20 tracking-[0.2em] uppercase font-light">
        {t.footer.derechos}
      </p>
    </div>
  </div>
</footer>
