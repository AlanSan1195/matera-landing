---
const { src, name, description, price, nameTranslation, descripTranslation } = Astro.props;
---

<div class="relative flex flex-col items-center gap-y-2 transition-all duration-500 border-b border-red-900/30 rounded-xl group p-4 before:w-full before:h-full before:rounded-xl before:backdrop-blur-sm before:z-10 before:absolute overflow-hidden hover:border-red-800/50">
  <div
    class="relative shrink-0 opacity-40 w-max z-50 blur-[1px] transition-all duration-500 group-hover:blur-none group-hover:-translate-y-1 translate-y-3 group-hover:opacity-100"
  >
    <img
      class="h-20 w-20 md:h-24 md:w-24 object-cover mx-auto drop-shadow-[2px_4px_8px_rgba(0,0,0,0.5)]"
      src={src}
      alt={name}
      loading="lazy"
      decoding="async"
      width="96"
      height="96"
    />
  </div>
  <p
    class="text-center font-display text-sm md:text-base leading-snug text-white/65 transition-all duration-500 z-[60] group-hover:text-white/90 shrink-0 tracking-wide"
  >
    {name}
  </p>
  {nameTranslation && (
    <p class="text-center text-[10px] leading-tight text-white/30 italic z-[60] transition-all duration-500 group-hover:text-white/50 shrink-0">
      {nameTranslation}
    </p>
  )}
  <p
    class="text-center text-[11px] leading-relaxed text-white/40 transition-all duration-500 z-[60] group-hover:text-white/70 line-clamp-2 shrink-0 px-2"
  >
    {descripTranslation || description}
  </p>
  <p
    class="text-center text-xs font-display text-white/50 transition-all duration-500 z-[60] group-hover:text-white/80 shrink-0 mt-auto tracking-wide"
  >
    {price}
  </p>
</div>
