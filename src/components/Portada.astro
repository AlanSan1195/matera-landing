---
const { color, subtitle, tagline, id } = Astro.props;

// Mapa de clases literales para que Tailwind JIT las detecte
const textColorMap: Record<string, string> = {
  white: "text-white",
  black: "text-black",
  red: "text-red-700",
  secundary: "text-secundary",
  primary: "text-primary",
};
const textColor = textColorMap[color] ?? "text-white";
---

<section
  class="landing-section min-h-screen w-screen text-center overflow-hidden flex items-center"
  data-header-color={color}
  id={id}
>
  <div
    class="z-30 relative h-auto text-end m-2 w-[90%] md:w-[80%] lg:w-[65%] xl:w-[70%] max-w-[1200px] flex flex-col flex-wrap ml-auto text-pretty"
  >
    <header class="lg:p-2">
      <h1
        class={`${textColor} font-display mr-2 mt-4 lg:mr-4 pt-16 md:pt-20 lg:pt-28 xl:pt-48 text-[5rem] sm:text-7xl md:text-8xl lg:text-8xl xl:text-9xl 2xl:text-[10rem] leading-[.95] text-opacity-95 tracking-[-0.02em] italic`}
      >
        <span class="text-red-700 text-[0.85em] not-italic font-semibold align-top inline-block mt-2">"</span>{tagline ?? "Buenos Amigos, Buenos Vinos, Buenos Aires."}<span
          class="text-red-700 text-[0.85em] not-italic font-semibold align-top inline-block mt-2">"</span
        >
      </h1>
      <p
        class={`${textColor} mr-2 ml-5 text-pretty lg:mr-4 text-xs sm:text-base md:text-lg xl:text-xl font-light mt-6 md:mt-8 tracking-[0.15em] uppercase opacity-75 leading-relaxed max-w-2xl sm:max-w-3xl ml-auto`}
      >
        {subtitle}
      </p>
    </header>

    <footer
      class="py-8 md:py-10 flex flex-col flex-grow justify-end mr-auto ml-auto md:mr-14"
    >
      <slot name="footer" />
    </footer>
  </div>

  <div class="absolute top-0 bottom-0 h-full w-full z-10 hidden md:block">
    <slot name="background" />
  </div>
</section>

