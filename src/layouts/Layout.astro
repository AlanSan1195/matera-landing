---
import LightsBackground from "@/components/LightsBackground.astro";

import "@fontsource-variable/lora";
import "@fontsource/permanent-marker";

export interface Props {
  title: string;
  description: string;
  lang?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, lang = "es", ogImage, canonical, noindex = false } = Astro.props;

const SITE_URL = "https://www.lamatera.app";
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ? `${SITE_URL}${canonical}` : `${SITE_URL}${currentPath}`;
const ogImageUrl = ogImage ? `${SITE_URL}${ogImage}` : `${SITE_URL}/imagenes/preview.webp`;

const ogLocaleMap: Record<string, string> = {
  es: "es_ES",
  en: "en_US",
  ko: "ko_KR",
  zh: "zh_CN",
  ja: "ja_JP",
};
const ogLocale = ogLocaleMap[lang] ?? "es_ES";

const pathSegments = currentPath.split("/").filter(Boolean);
const breadcrumbItems = [
  { name: lang === "es" ? "Inicio" : "Home", item: SITE_URL + "/" }
];
let accumulatedPath = "";
for (const segment of pathSegments) {
  accumulatedPath += `/${segment}`;
  const isLast = segment === pathSegments[pathSegments.length - 1];
  const name = isLast 
    ? segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " ")
    : segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, " ");
  breadcrumbItems.push({ 
    name: isLast && lang === "es" ? (name === "En" ? "English" : name === "Ko" ? "Korean" : name === "Zh" ? "Chinese" : name === "Ja" ? "Japanese" : name) : name,
    item: `${SITE_URL}${accumulatedPath}${isLast ? "" : "/"}`
  });
}
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://accounts.dev" crossorigin />
    <link rel="dns-prefetch" href="https://accounts.dev" />
    <link rel="preconnect" href="https://www.google.com" crossorigin />
    <link rel="preconnect" href="https://www.instagram.com" crossorigin />
    <link rel="preconnect" href="https://graph.facebook.com" crossorigin />
    <link rel="preload" href="/fuentes/Magical Night.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="icon"
      type="image/webp"
      href="/imagenes/logo-cabecera.webp"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/imagenes/logo-cabecera.webp" />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="description"
      content={description}
    />
    <meta name="google-site-verification" content="zuRgqcQ25AX8z3a-qvX5CG-Gfy_eYJSoUt_T7LDRQG4" />
    <meta name="keywords" content="comida,vino,restaurante,argentina,cava,servicio,chef,eventos,argentino,cortes,bife,lomo,vacio,entraña,asado,chorizo,lomito,rib eye,parrilla,facturacion" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="La Matera — Restaurante Argentino en Guadalajara" />
    <meta property="og:image" content={ogImageUrl} />
    <meta content="summary_large_image" name="twitter:card" />
    <meta name="twitter:site" content="@lamateragdl" />
    <meta name="twitter:creator" content="@AlanSan86780460" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="alternate" hreflang="es" href={`${SITE_URL}/`} />
    <link rel="alternate" hreflang="en" href={`${SITE_URL}/en/`} />
    <link rel="alternate" hreflang="ko" href={`${SITE_URL}/ko/`} />
    <link rel="alternate" hreflang="zh" href={`${SITE_URL}/zh/`} />
    <link rel="alternate" hreflang="ja" href={`${SITE_URL}/ja/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "name": "La Matera",
        "description": "Restaurante argentino en Guadalajara con más de 30 años de trayectoria. Especialistas en Parrilla Argentina, empanadas, pizzas y vino.",
        "url": "https://www.lamatera.app",
        "telephone": "+523336853060",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Manuel Acuña 2769, Providencia",
          "addressLocality": "Guadalajara",
          "addressRegion": "Jalisco",
          "postalCode": "44630",
          "addressCountry": "MX"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "20.6775",
          "longitude": "-103.3467"
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "13:00",
            "closes": "23:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Saturday", "Sunday"],
            "opens": "13:00",
            "closes": "00:00"
          }
        ],
        "priceRange": "$$",
        "servesCuisine": ["Argentine", "Grill", "Steakhouse"],
        "acceptsReservations": true,
        "hasMenu": "https://www.lamatera.app/#carta",
        "image": "https://www.lamatera.app/imagenes/preview.webp",
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.7",
          "reviewCount": "892",
          "bestRating": "5"
        },
        "review": {
          "@type": "Review",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5"
          },
          "author": {
            "@type": "Person",
            "name": "TripAdvisor User"
          }
        },
        "sameAs": [
          "https://www.instagram.com/lamateragdl",
          "https://www.facebook.com/lamateragdl",
          "https://www.tripadvisor.com/Restaurant_Review-g150789-d5019695-Reviews-La_Matera-Guadalajara_Guadalajara_Mexico.html"
        ]
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Qué tipo de comida sirven en La Matera?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Somos un restaurante argentino especializado en Parrilla Argentina, empanadas, pizzas artesanales y tenemos una de las cavas de vino más reconocidas de Guadalajara."
            }
          },
          {
            "@type": "Question",
            "name": "¿La Matera acepta reservaciones?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí, aceptamos reservaciones. Puedes visitar nuestra sección de reservas en el sitio o llamarnos directamente."
            }
          },
          {
            "@type": "Question",
            "name": "¿Cuáles son los horarios de atención?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Abiertos de lunes a viernes de 13:00 a 23:00 horas, y sábados y domingos de 13:00 a 00:00 horas."
            }
          },
          {
            "@type": "Question",
            "name": "¿Dónde está ubicado La Matera?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Estamos en Av. Manuel Acuña 2769, Providencia, Guadalajara, Jalisco, C.P. 44630."
            }
          }
        ]
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "La Matera",
        "url": "https://www.lamatera.app",
        "logo": "https://www.lamatera.app/imagenes/logo-cabecera.webp",
        "description": "Restaurante argentino en Guadalajara con más de 30 años de trayectoria.",
        "sameAs": [
          "https://www.instagram.com/lamateragdl",
          "https://www.facebook.com/lamateragdl"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+523336853060",
          "contactType": "customer service",
          "availableLanguage": ["Spanish", "English"]
        },
        "founder": {
          "@type": "Person",
          "name": "Familia Bastian"
        },
        " foundingDate": "1990",
        "areaServed": {
          "@type": "City",
          "name": "Guadalajara"
        },
        "serviceType": "Restaurant"
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://www.lamatera.app/"
          }
          ${breadcrumbItems.slice(1).map((item, index) => `
          ,{
            "@type": "ListItem",
            "position": ${index + 2},
            "name": "${item.name}",
            "item": "${item.item}"
          }`).join("")}
        ]
      }
    </script>
  </head>
  <body>
    <LightsBackground />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --primary: #0e191a;
  }
  @font-face {
    font-family: "boldes";
    src: url("/fuentes/Magical\ Night.woff2");
    font-display: swap;
  }
  html,
  body {
    overflow-x: hidden;
  }
  html {
    font-family: "Lora Variable";
  }

  /* Tailwind Preflight ya aplica el reset universal (margin, padding, box-sizing) */
  video {
    mask-image: linear-gradient(grey 90%, transparent 100%);

  }
  [data-carrusel] {
      mask-image: linear-gradient(to bottom, transparent 1%, black 10%);
    }
  @media (min-width: 768px) {
    [data-carrusel] {
      mask-image: linear-gradient(to bottom, transparent 1%, black 10%);
    }
    #nosotros {
      mask-image: linear-gradient(black 98%, transparent 100%);
    }
  }

  .invisible {
    display: none;
  }

  /* efecto de REFELEJO para imagen de nostros */
  .nosotros-img {
    border-radius: 13px;

    object-fit: cover;
    background: hsl(10 80% 100%);
    -webkit-box-reflect: below 6px
      linear-gradient(transparent 0 80%, hsl(0 0% 100% / 0.6) 100%);
  }
  .nosotros-img2 {
    border-radius: 13px;

    object-fit: cover;
    background: hsl(10 80% 100%);
    -webkit-box-reflect: below 6px
      linear-gradient(transparent 0 80%, hsla(0, 0%, 100%, 0.242) 100%);
  }

  .image-drop-shadow-empanadas {
    height: 6rem; /* Altura fija de 12rem */
    width: 6rem; /* Ancho fijo de 12rem */
    object-fit: cover; /* Asegura que la imagen cubra todo el espacio asignado sin deformarse */
    /* Margen superior de 0.5rem */
    margin-right: 0.5rem; /* Margen derecho de 0.5rem */
    margin-left: auto; /* Margen izquierdo automático para centrar horizontalmente */
    filter: drop-shadow(
      2px 4px 6px black
    ); /* Sombra con desplazamiento horizontal de 2px, vertical de 4px y difuminado de 6px */
  }
  .image-drop-shadow {
    height: 8rem; /* Altura fija de 12rem */
    width: 8rem; /* Ancho fijo de 12rem */
    object-fit: cover; /* Asegura que la imagen cubra todo el espacio asignado sin deformarse */
    /* Margen superior de 0.5rem */
    margin-right: 0.5rem; /* Margen derecho de 0.5rem */
    margin-bottom: 0.9rem;
    margin-left: auto; /* Margen izquierdo automático para centrar horizontalmente */
    filter: drop-shadow(
      2px 4px 6px black
    ); /* Sombra con desplazamiento horizontal de 2px, vertical de 4px y difuminado de 6px */
  }
  .simple-radial {
    background: radial-gradient(rgb(80, 82, 78), rgb(0, 0, 0));
  }

</style>
